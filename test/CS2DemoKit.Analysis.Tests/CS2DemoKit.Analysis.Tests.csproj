<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CS2DemoKit.Analysis\CS2DemoKit.Analysis.csproj"/>
        <ProjectReference Include="..\..\src\CS2DemoKit.Analysis.Rules\CS2DemoKit.Analysis.Rules.csproj"/>
        <ProjectReference Include="..\CS2DemoKit.TestSupport\CS2DemoKit.TestSupport.csproj"/>
        <!-- Catalog drift gate: the test regenerates the catalog from the live registries and
             byte-compares it against the committed Rules/catalog.json. -->
        <ProjectReference Include="..\..\tools\CS2DemoKit.RulesCatalog\CS2DemoKit.RulesCatalog.csproj"/>
    </ItemGroup>

</Project>
