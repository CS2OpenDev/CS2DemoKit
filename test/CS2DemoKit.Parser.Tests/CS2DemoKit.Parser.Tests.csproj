<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <!-- The upstream emitted-wrapper package (SDK#25 stages 2+3 verification). TEST-ONLY on
             purpose: the parser library keeps depending on the Abstractions contract alone;
             adopting the emitted wrappers in production is a separate decision. -->
        <PackageReference Include="CS2OpenDev.Sdk.Entities"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CS2DemoKit.Parser\CS2DemoKit.Parser.csproj"/>
        <ProjectReference Include="..\CS2DemoKit.TestSupport\CS2DemoKit.TestSupport.csproj"/>
    </ItemGroup>

</Project>
