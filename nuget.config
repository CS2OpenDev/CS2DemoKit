<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <!-- Repo-local feed for the CS2OpenDev family, which publishes to GitHub Packages rather
             than nuget.org. Committed .nupkg files keep bare-clone and CI builds working with no
             credentials — GitHub Packages requires a read:packages PAT even for public packages.
             Refresh: copy the new .nupkg here, bump the version in Directory.Packages.props. -->
        <add key="local" value="local-packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <!-- Without this explicit pattern the `*` above routes CS2OpenDev* to nuget.org and a clean
             restore (fresh runner, no global cache) fails with NU1102. Most-specific match wins.
             Keep in sync with Directory.Packages.props. -->
        <packageSource key="local">
            <package pattern="CS2OpenDev*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
