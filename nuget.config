<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <!-- Repo-local feed for the CS2OpenDev family. The pinned versions ship on nuget.org
             (since the 2026-08 public line), but the committed .nupkg files keep bare-clone and
             CI builds hermetic and offline — restores never depend on a remote feed's contents.
             Refresh: copy the new .nupkg here, bump the version in Directory.Packages.props. -->
        <add key="local" value="local-packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <!-- Most-specific match wins: CS2OpenDev* restores from the committed local feed, never
             the network, keeping builds hermetic. Keep in sync with Directory.Packages.props. -->
        <packageSource key="local">
            <package pattern="CS2OpenDev*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
