<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Versioning. Injected into every project by Directory.Build.props. -->
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.7.115"/>

        <!-- Parser runtime. Google.Protobuf is a genuine public dependency (NetMessage.Payload is
             an IMessage); Snappier decompresses the demo frame payloads. -->
        <PackageVersion Include="Google.Protobuf" Version="3.29.5"/>
        <PackageVersion Include="Snappier" Version="1.3.1"/>

        <!--
            The CS2OpenDev family — community-maintained CS2 schema, protobuf and game-event
            definitions (github.com/CS2OpenDev). Ships on nuget.org under the renumbered public
            line (2026-08, replacing the withdrawn 5.x GitHub Packages line) and restores from
            there like every other dependency.
        -->
        <PackageVersion Include="CS2OpenDev.Protos" Version="0.9.0"/>
        <PackageVersion Include="CS2OpenDev.Sdk" Version="0.9.0"/>
        <PackageVersion Include="CS2OpenDev.Sdk.GameEvents" Version="0.9.0"/>
        <PackageVersion Include="CS2OpenDev.Sdk.Entities.Abstractions" Version="1.0.3"/>
        <PackageVersion Include="CS2OpenDev.Sdk.Entities" Version="1.1.3"/>

        <!-- Analysis. Logging is abstractions-only (no provider), YAML is the rule format. -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="YamlDotNet" Version="16.3.0"/>

        <!-- Tests. TUnit, not xUnit/NUnit — heavy fixtures rely on its [NotInParallel]. -->
        <PackageVersion Include="TUnit" Version="0.25.21"/>
    </ItemGroup>
</Project>
