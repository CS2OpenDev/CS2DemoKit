<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CS2DemoKit.Parser\CS2DemoKit.Parser.csproj"/>
        <!-- The lens registry is DERIVED from the SDK-emitted bindings (single curation
             authority upstream); the deriver enumerates EntityWrapperRegistry.Bindings. -->
        <PackageReference Include="CS2OpenDev.Sdk.Entities"/>
    </ItemGroup>

</Project>
