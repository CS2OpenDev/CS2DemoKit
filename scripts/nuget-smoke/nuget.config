<?xml version="1.0" encoding="utf-8"?>
<!--
    Its own config, not the repo's. `<clear/>` drops the repo-level sources so this consumer can
    only see nuget.org and the freshly packed nupkgs — which is what makes it a real test of the
    packages rather than of the project graph.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <add key="smoke" value="../../artifacts/pack" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <packageSource key="smoke">
            <package pattern="CS2DemoKit*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
