<?xml version="1.0" encoding="utf-8"?>
<!--
    Its own config, not the repo's. `<clear/>` drops the repo-level sources so this consumer can
    only see nuget.org, the freshly packed nupkgs, and the CS2OpenDev folder feed — which is what
    makes it a real test of the packages rather than of the project graph.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <add key="smoke" value="../../artifacts/pack" />
        <add key="local" value="../../local-packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <packageSource key="smoke">
            <package pattern="CS2DemoKit*" />
        </packageSource>
        <!-- The CS2OpenDev family is on GitHub Packages, not nuget.org; a consumer resolves it the
             same way this repo does. When that family reaches nuget.org, delete this mapping — and
             this consumer stops proving anything the public feed would not. -->
        <packageSource key="local">
            <package pattern="CS2OpenDev*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
